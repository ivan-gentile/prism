# PRISM-AD Multi-Provider Configuration
# Copy this file to .env and fill in your API keys

# ===== PRIMARY PROVIDER (OpenAI) =====
# Your OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Override default OpenAI settings
# BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# ===== FASTWEB PROVIDER =====
# Enable FastWeb integration (set to "true" to enable)
FASTWEB_ENABLED=false

# FastWeb API endpoint (basepod1 environment)
FASTWEB_BASE_URL=https://bpod1.ai-factory.fastweb.it/v1

# Default FastWeb model to use
# Available models: meta/llama-3-3-70b-instruct, Fastweb/FastwebMIIA-7B, google/gemma-3-27b-it
FASTWEB_MODEL=meta/llama-3-3-70b-instruct

# FastWeb JWT Tokens (each model requires its own JWT token)
# Note: These are the hackathon tokens valid until expiry date
# Production environment: basepod1, Application ID: hackathon

# Token for Fastweb/FastwebMIIA-7B model
FASTWEB_TOKEN_MIIA=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6IjAwMDEifQ.eyJpc3MiOiJodHRwczovL2FpLWZhY3RvcnkuZmFzdHdlYi5pdCIsInN1YiI6ImhhY2thdGhvbiIsInRlbmFudCI6ImJhc2Vwb2QxIiwibmFtZXNwYWNlIjoibmltLW1paWEiLCJpYXQiOjE3NTY0NTU4MjksImV4cCI6MTc4OTI1NzYwMH0.ZmFudGFzdGljand0

