# PRISM-AD Multi-Provider Configuration
# Copy this file to .env and fill in your API keys

# ===== PRIMARY PROVIDER (OpenAI) =====
# Your OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Override default OpenAI settings
# BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# ===== FASTWEB PROVIDER =====
# Enable FastWeb integration (set to "true" to enable)
FASTWEB_ENABLED=false

# Your FastWeb API key
FASTWEB_API_KEY=your_fastweb_api_key_here

# FastWeb API endpoint
FASTWEB_BASE_URL=https://api.ai-fastweb.it/v1

# FastWeb model to use
FASTWEB_MODEL=Llama-3.3-70B-Instruct

# ===== AGENT PROVIDER MAPPING =====
# You can override which provider each agent uses by setting these
# Options: "primary" (OpenAI) or "fastweb"
# Note: quant_model requires tool support, so it should use "primary"

# AGENT_PARSER_PROVIDER=primary
# AGENT_VALIDATOR_PROVIDER=primary
# AGENT_CLASSIFIER_PROVIDER=fastweb
# AGENT_RISK_CALCULATOR_PROVIDER=fastweb
# AGENT_REPORTER_PROVIDER=primary

# ===== OTHER CONFIGURATION =====
# PRIMARY_PROVIDER=openai
